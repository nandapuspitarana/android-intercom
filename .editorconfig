root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 160
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# A file may hold a few small related classes (messages, screens, states).
ktlint_standard_filename = disabled
# Wildcards are never used, but generated test fixtures may use them.
ktlint_standard_no-wildcard-imports = enabled

[*.{xml,toml,md,yml,yaml}]
indent_size = 2
